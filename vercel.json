{
  "crons": [
    {
      "path": "/api/refresh-intel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/refresh-news",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/refresh-tenders",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|team/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}