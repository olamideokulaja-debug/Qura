{
  "crons": [
    {
      "path": "/api/refresh-intel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/refresh-news",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/refresh-tenders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/archive-refresh",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/opps-refresh",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/send-schools",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/send-discover",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/send-vacancies",
      "schedule": "5-59/10 * * * *"
    },
    {
      "path": "/api/send-alerts",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/send-councils",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/send-tenders",
      "schedule": "2-59/10 * * * *"
    },
    {
      "path": "/api/send-therapists",
      "schedule": "40 8 * * 1"
    },
    {
      "path": "/api/send-accuracy",
      "schedule": "40 6 * * 1"
    },
    {
      "path": "/api/send-councilplans",
      "schedule": "25 */2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/send-intelligence",
      "destination": "/?open=send",
      "permanent": false
    },
    {
      "source": "/send.html",
      "destination": "/?open=send",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/for-clinicians",
      "destination": "/for-clinicians.html"
    },
    {
      "source": "/for-suppliers",
      "destination": "/for-suppliers.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    },
    {
      "source": "/inside-the-platform",
      "destination": "/inside-the-platform.html"
    },
    {
      "source": "/solutions",
      "destination": "/solutions.html"
    },
    {
      "source": "/fragile-professions",
      "destination": "/fragile-professions.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/our-story",
      "destination": "/our-story.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/refer",
      "destination": "/join.html"
    },
    {
      "source": "/founding-partner",
      "destination": "/founding-partner.html"
    },
    {
      "source": "/send-data",
      "destination": "/send-data.html"
    },
    {
      "source": "/send",
      "destination": "/send-specialists.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
